# Environment de Producción - Render
# IMPORTANTE: No commitear este archivo con valores reales

# Environment
NODE_ENV=production
PORT=3000

# Database Configuration (Render automáticamente configura estos valores)
DB_HOST=<render-postgres-hostname>
DB_PORT=5432
DB_NAME=mariabags
DB_USER=<render-db-user>
DB_PASSWORD=<render-db-password>

# JWT Configuration
# CRÍTICO: Generar un secret completamente aleatorio en producción
# Ejecutar: openssl rand -base64 64
JWT_SECRET=<GENERAR_CON_OPENSSL_RAND_BASE64_64>
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
# Usar la URL del frontend desplegado en Render
CORS_ORIGIN=https://mariabags-frontend.onrender.com

# Bcrypt Configuration
BCRYPT_ROUNDS=12
