# Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mariabags
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT Configuration
# IMPORTANTE: Generar secret aleatorio para producción (mínimo 32 caracteres)
# Ejemplo: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Bcrypt Configuration (10-12 rounds recomendado)
BCRYPT_ROUNDS=12
